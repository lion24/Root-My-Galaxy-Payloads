+/* Samsung's CONFIG_KDP_NS splits a mount into two allocations: the fields live in
+ * struct mount (the object the ns->list walk reaches), and the vfsmount details
+ * (mnt_root / mnt_sb / mnt_flags) live in a separate struct kdp_vfsmount reached
+ * through the hidden pointer behind the mount's fields.  Sourced from the device's
+ * own BTF (S916BXXUAGZIF: struct kdp_mount 360 bytes, mnt at 352 = 0x160; struct
+ * kdp_vfsmount 72 bytes, bp_mount at 64) and from this tree's fs/mount.h +
+ * fs/namespace.c, which read every vfsmount field as ((struct kdp_mount *)mnt)->mnt
+ * when CONFIG_KDP_NS is set.  A real fs/namespace.c mount never initializes the
+ * embedded `mnt` copy under KDP: crash RWC 120 (d_path given a NULL dentry read
+ * back from r+0x20 on the same mount whose real kdp vfsmount was live) is exactly
+ * that shape.  The seq_file cursor is the one exception: proc_namespace.c sets
+ * cursor.mnt.mnt_flags = MNT_CURSOR on the EMBEDDED copy and its kdp pointer is
+ * past the end of struct proc_mounts (never deref it), which is why the cursor
+ * test keeps reading r->mnt.mnt_flags while real-mount field reads go through here. */
+static inline struct vfsmount *sus_mount_mnt_of(struct mount *r)
+{
+#ifdef CONFIG_KDP_NS
+    return ((struct kdp_mount *)r)->mnt;
+#else
+    return &r->mnt;
+#endif
+}
