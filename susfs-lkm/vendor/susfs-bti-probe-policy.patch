+		if (susfs_bti_landing_pad(insn)) {
+			if (i == 0)
+				saw_pad = true;
+			pc += sizeof(insn);
+			continue;
+		}
+		if (susfs_bti_pac_pad(insn)) {
+			if (i == 0)
+				saw_pad = true;		/* paciasp IS a landing pad */
+			signed_lr = true;
+			pc += sizeof(insn);
+			continue;
+		}
+		/* Only BETWEEN byte 0 and the PAC instruction, and only a conditional guard: at
+		 * byte 0 a branch means the entry is a thunk, and without a PAC instruction after
+		 * it there is nothing left to skip. */
+		if (i > 0 && !signed_lr && susfs_bti_guard(insn)) {
+			pc += sizeof(insn);
+			continue;
+		}
+		break;
+	}
+	if (i == 8) {
+		/* eight pads/guards and no body: not a function entry */
+		susfs_bti_log_words(sym, body);
+		pr_warn("susfs_bti: %s: eight landing pads/guards and no body (first word %08x) - not a function entry, not armed\n",
+			sym ?: "?", first);
+		return -EINVAL;
+	}
+	if (entry_must_be_pad && !saw_pad) {
+		/* The failure RWC 123 cost a boot: a "+0" here replaces the landing pad an indirect
+		 * branch checks, so the arm is refused outright instead of trusting the answer. */
+		susfs_bti_log_words(sym, body);
+		pr_warn("susfs_bti: %s: byte 0 is %08x, not a BTI/PAC landing pad, but a table or a resolved pointer reaches this entry - arming anywhere (including +0) would break the indirect branch that reaches it; refused\n",
+			sym ?: "?", first);
+		return -EOPNOTSUPP;
+	}
+	if (susfs_bti_unsteppable(insn)) {
+		/* no point found that kprobes can single-step */
+		susfs_bti_log_words(sym, body);
+		pr_warn("susfs_bti: %s: the point after its prologue is %08x, which kprobes cannot single-step - not armed\n",
+			sym ?: "?", insn);
+		return -EOPNOTSUPP;
+	}
+
+	*probe = pc;
+	*pac_lr = signed_lr;
+	/* A "+0" answer is a claim that byte 0 itself may be replaced, and a pointer-reached entry's
+	 * answer is a claim about byte 0's landing pad: print the words both rest on, so the next log
+	 * says what the classifier actually saw rather than only what it concluded. */
+	if (entry_must_be_pad || pc == body)
+		susfs_bti_log_words(sym, body);
+	return 0;
+}
+
+/* Kprobe point for an entry NOT known to be pointer-reached: byte 0 may be used when it is the
+ * only steppable instruction (a leaf or direct-call function with no BTI prefix). */
+static inline int susfs_bti_probe_point(unsigned long body, unsigned long *probe, bool *pac_lr)
+{
+	return susfs_bti_probe_point_impl(NULL, body, probe, pac_lr, false);
+}
+
+/* Kprobe point for an entry that sys_call_table, a security_hook slot or an op->show reaches
+ * through a pointer: byte 0 must BE the observed landing pad, or the arm is refused. */
+static inline int susfs_bti_probe_point_pad_entry(const char *sym, unsigned long body,
+						  unsigned long *probe, bool *pac_lr)
+{
+	return susfs_bti_probe_point_impl(sym, body, probe, pac_lr, true);
+}
+
+/* KRETPROBE point.  @probe_on_pac says the point is the paciasp itself (so the trampoline
+ * substitution happens before signing); @entry_is_pad says the probe is at byte 0 AND byte 0 is
+ * the landing pad, i.e. arming here breaks BTI for any indirect caller - the caller decides,
+ * because only it knows whether the function can be reached through a pointer. */
+static inline int susfs_bti_kretprobe_point(unsigned long body, unsigned long *probe,
+					    bool *probe_on_pac, bool *entry_is_pad)
+{
+	unsigned int insn;
+	unsigned long pc = body;
+	bool saw_pad = false;
+	int i;
+
+	*probe_on_pac = false;
+	*entry_is_pad = false;
+
+	for (i = 0; i < 8; i++) {
+		if (copy_from_kernel_nofault(&insn, (void *)pc, sizeof(insn)))
+			return -EFAULT;
+		if (susfs_bti_landing_pad(insn)) {
+			saw_pad = true;
+			pc += sizeof(insn);
+			continue;
+		}
+		if (susfs_bti_pac_pad(insn)) {
+			*probe = pc;
+			*probe_on_pac = true;
+			*entry_is_pad = (pc == body);
+			return 0;
+		}
+		if (!saw_pad)
+			break;		/* byte 0, and it is not a landing pad */
+		if (susfs_bti_guard(insn)) {
+			pc += sizeof(insn);
+			continue;
+		}
+		break;			/* a pad, then a body with no PAC instruction */
+	}
+	if (i == 8)
+		return -EINVAL;
+	if (susfs_bti_unsteppable(insn))
+		return -EOPNOTSUPP;
+
+	*probe = pc;
+	*probe_on_pac = false;
+	*entry_is_pad = false;
+	return 0;
+}
+
+/* Resolve the probe's symbol and set .offset so it lands past the prologue prefix.  .symbol_name
+ * is deliberately KEPT: kprobes allows .symbol_name + .offset (it refuses both .addr and
+ * .symbol_name), the offset is added exactly once by _kprobe_addr(), and the handlers print
+ * kp->symbol_name in their log lines.  .addr must be NULL on entry and after every failure - see
+ * susfs_kprobe.h for why a retry inherits it otherwise. */
+static inline int susfs_bti_arm_kprobe_impl(struct kprobe *kp, bool entry_must_be_pad)
+{
+	unsigned long body, probe;
+	bool pac_lr = false;
+	int rc;
+
+	if (!kp->symbol_name) {
+		pr_warn("susfs_bti: a kprobe with no symbol name cannot be classified - not armed\n");
+		return -EINVAL;
+	}
+	kp->addr = NULL;
+
+	body = ksu_kallsyms_lookup_name(kp->symbol_name);
+	if (!body) {
+		pr_warn("susfs_bti: %s is not in kallsyms - nothing to arm\n", kp->symbol_name);
+		return -ENOENT;
+	}
+
+	rc = susfs_bti_probe_point_impl(kp->symbol_name, body, &probe, &pac_lr, entry_must_be_pad);
+	if (rc) {
+		pr_warn("susfs_bti: %s+0 (%px) has no point kprobes may take after its landing pads (%d) - not armed\n",
+			kp->symbol_name, (void *)body, rc);
+		return rc;
+	}
+
+	kp->offset = (unsigned int)(probe - body);
+	SUSFS_LOGI("susfs_bti: %s body=%px probe=%px (+%u%s)\n",
+		   kp->symbol_name, (void *)body, (void *)probe, kp->offset,
+		   pac_lr ? ", past its PAC prologue - the resume strips it" : ", no landing pad was skipped");
+	if (entry_must_be_pad)
+		SUSFS_LOGI("susfs_bti: %s is pointer-reached and its byte 0 is a landing pad the probe leaves intact\n",
+			   kp->symbol_name);
+	return 0;
+}
+
+/* Arm a kprobe whose entry is not known to be reached through a pointer. */
+static inline int susfs_bti_arm_kprobe(struct kprobe *kp)
+{
+	return susfs_bti_arm_kprobe_impl(kp, false);
+}
+
+/* Arm a kprobe on an entry that sys_call_table, a security_hook slot or an op->show reaches
+ * through a pointer: refused unless byte 0 was OBSERVED to be a landing pad. */
+static inline int susfs_bti_arm_kprobe_pad_entry(struct kprobe *kp)
+{
+	return susfs_bti_arm_kprobe_impl(kp, true);
+}
+
+/* The kernel's global "every probe is disarmed" switch.  register_kprobe() checks it before it
+ * even looks at kp->flags and returns 0 without arming anything when it is set, which is
+ * indistinguishable from a real arm by return code alone (measured: register_kprobe+0x314).
+ * CONFIG_KALLSYMS_ALL makes this static bool resolvable at runtime; -1 means it is not (an older
+ * tree, or a build without KALLSYMS_ALL), so the caller reports "unknown" rather than "armed". */
+static inline int susfs_bti_kprobes_disarmed(void)
+{
+	bool *p = (bool *)ksu_kallsyms_lookup_name("kprobes_all_disarmed");
+
+	if (!p)
+		return -1;
+	return READ_ONCE(*p) ? 1 : 0;
+}
+
+/* After register_kprobe() returns success, confirm the instruction it claims to have replaced is
+ * the BRK kprobes installs.  arch_arm_kprobe() returns void and DISCARDS the text-write result, so
+ * a write the hypervisor refuses is a silent non-arm that register_kprobe() still reports as 0 -
+ * this read-back is the only way to tell from inside the module. */
+static inline int susfs_bti_verify_armed(struct kprobe *kp)
+{
+	unsigned int insn = SUSFS_BTI_WORD_READ_FAILED;
+
+	if (!kp->addr)
+		return -EINVAL;
+	if (copy_from_kernel_nofault(&insn, kp->addr, sizeof(insn))) {
+		pr_warn("susfs_bti: %s @%px: cannot read the armed site back - the arm cannot be confirmed\n",
+			kp->symbol_name ?: "?", (void *)kp->addr);
+		return -EFAULT;
+	}
+	if (insn != SUSFS_BTI_INSN_BRK) {
+		pr_warn("susfs_bti: %s @%px was NOT armed: read back %08x, expected %08x (offset=%u flags=%x) - the text write was refused or the probe was skipped\n",
+			kp->symbol_name ?: "?", (void *)kp->addr, insn, SUSFS_BTI_INSN_BRK,
+			kp->offset, kp->flags);
+		return -EIO;
+	}
+	SUSFS_LOGI("susfs_bti: %s @%px verified armed (read back %08x)\n",
+		   kp->symbol_name ?: "?", (void *)kp->addr, insn);
+	return 0;
+}
+
+/* Resolve @kr's symbol and arm it at the only offset a return probe has: the instruction that
+ * signs the trampoline substitution.  @direct_only is the caller's proof that no indirect branch
+ * can reach this function's byte 0 (a static function with no address taken, checked against the
+ * device's disassembly); without it, a paciasp-at-0 entry is refused rather than armed. */
+static inline int susfs_bti_arm_kretprobe(struct kretprobe *kr, bool direct_only,
+					  const char *direct_only_why)
+{
+	unsigned long body, probe;
+	bool on_pac = false, entry_pad = false;
+	int rc;
+
+	if (!kr->kp.symbol_name) {
+		pr_warn("susfs_bti: a kretprobe with no symbol name cannot be classified - not armed\n");
+		return -EINVAL;
+	}
+	kr->kp.addr = NULL;
+
+	body = ksu_kallsyms_lookup_name(kr->kp.symbol_name);
+	if (!body) {
+		pr_warn("susfs_bti: %s is not in kallsyms - nothing to arm\n", kr->kp.symbol_name);
+		return -ENOENT;
+	}
+
+	rc = susfs_bti_kretprobe_point(body, &probe, &on_pac, &entry_pad);
+	if (rc) {
+		pr_warn("susfs_bti: %s+0 (%px) has no point a return probe may take (%d) - not armed\n",
+			kr->kp.symbol_name, (void *)body, rc);
+		return rc;
+	}
+
+	if (entry_pad && !direct_only) {
+		pr_warn("susfs_bti: refusing kretprobe(%s): its entry IS its BTI landing pad (paciasp at byte 0), and a return probe cannot be moved past the instruction that must sign its trampoline - that feature stays off (reached through %s) - see the header comment\n",
+			kr->kp.symbol_name, direct_only_why ? direct_only_why : "a table or a resolved pointer");
+		return -EOPNOTSUPP;
+	}
+
+	kr->kp.offset = (unsigned int)(probe - body);
+	SUSFS_LOGI("susfs_bti: kretprobe %s body=%px probe=%px (+%u, %s)\n",
+		   kr->kp.symbol_name, (void *)body, (void *)probe, kr->kp.offset,
+		   entry_pad ? "byte 0 is paciasp, and this function is direct-call only: no indirect branch can reach its landing pad"
+			     : on_pac ? "armed on the PAC instruction after its bti landing pad: the pad stays and the substitution is signed"
+				      : "armed after its landing pads; the entry has no PAC instruction");
+	return 0;
+}
+
+/* Refuse an entry kretprobe on a function that is reached through a pointer.  @reached_through
+ * names the site (sys_call_table, an op->show/op->get_link slot, single_open's show argument,
+ * this module's own resolved function pointer), because the reasoning is site-specific - see the
+ * header comment for why neither offset 0 nor a later one can work for a return probe there. */
+static inline int susfs_bti_refuse_kretprobe(const char *symbol, const char *reached_through)
+{
+	pr_warn("susfs_bti: refusing kretprobe(%s): %s reaches it through a pointer, so byte 0 is its BTI landing pad and its PAC prologue makes any later offset unusable for a return probe - that feature stays off\n",
+		symbol, reached_through);
+	return -EOPNOTSUPP;
+}
+
+#endif /* __SUSFS_BTI_H */
