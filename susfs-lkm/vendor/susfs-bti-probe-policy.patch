+	for (i = 0; i < 8; i++) {
+		if (copy_from_kernel_nofault(&insn, (void *)pc, sizeof(insn))) {
+			susfs_bti_log_words(sym, body);
+			pr_warn("susfs_bti: %s: cannot read %px - not armed\n", sym ?: "?",
