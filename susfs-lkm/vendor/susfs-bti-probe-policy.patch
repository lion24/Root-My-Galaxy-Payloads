+		w[0], w[1], w[2], w[3]);
+}
+
+/* KPROBE point: the first instruction after the landing pads, an early-exit guard and the PAC
+ * instruction.  Skipping past paciasp is mandatory - a probe ON it would still delete the landing
+ * pad - and the caller already starts from a fresh `.offset`, so this runs on every arm.
+ *
+ * @entry_must_be_pad is the caller's statement that a table or a resolved pointer reaches this
+ * function's byte 0: then the only acceptable answer is one derived from a landing pad actually
+ * OBSERVED at byte 0, and anything else is refused rather than guessed.  @sym is only used in the
+ * evidence lines. */
