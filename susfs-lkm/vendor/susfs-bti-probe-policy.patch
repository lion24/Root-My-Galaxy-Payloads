+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * susfs_bti.h - where a probe may sit on this kernel's functions.
+ *
+ * Two different things make a probe fatal here, both measured on the device (RWC 121, RWC 123):
+ *
+ * 1. BTI.  CONFIG_ARM64_BTI_KERNEL is on, so every INDIRECT branch (`blr`) checks that the target
+ *    starts with a landing pad: `bti c`/`bti jc`, or `paciasp`/`pacibsp`.  kprobe replaces the
+ *    probed instruction with BRK, so a probe at byte 0 of such a target deletes the landing pad
+ *    and the next indirect call takes an "Oops - BTI" and panics.  Direct branches are NOT
+ *    checked, which is why a probe at byte 0 is still right for a function nothing calls through
+ *    a pointer.  RWC 121 was `seq_read_iter`'s `ldr x8,[op,#0x18]; blr x8` reaching m_show/s_show;
+ *    RWC 123 was `invoke_syscall`'s `ldr x20,[x2,w8,uxtw #3]; blr x20` reaching __arm64_sys_reboot.
+ *
+ *    Byte 0 is not the only instruction that can be a landing pad in practice: this kernel has
+ *    functions that begin `bti c; cbz/tbnz <early exit>; paciasp` (copy_mnt_ns and
+ *    get_user_pages_remote, both measured).  A probe on the `bti c` deletes the pad; a probe on
+ *    the guard is refused by arm64 kprobes itself (a branch is not steppable); the only sound
+ *    landing point is after the pads and past the guard.
+ *
+ * 2. PAC.  Every non-leaf function signs LR on entry (`paciasp`) and authenticates it in the
+ *    epilogue (`autiasp`, against SP).  So:
+ *
+ *      - a KPROBE may be MOVED past the prologue prefix.  Landing pads, an early-exit guard and
+ *        the PAC instruction are skipped, so no frame exists yet and leaving the function early
+ *        is exactly "it was never called".  But paciasp has already run, so LR holds a signed
+ *        value: the resume path must strip it (xpaci) before jumping to it.
+ *
+ *      - a KRETPROBE is trickier.  arch_prepare_kretprobe() saves regs->regs[30] as the return
+ *        address and writes &kretprobe_trampoline into x30; the callee's own paciasp must sign
+ *        that substituted value for the epilogue's autiasp to authenticate it.  So the probe
+ *        has to sit BEFORE the PAC instruction (or on it - kprobes single-steps it), and the
+ *        landing pad at byte 0 must survive.  That leaves exactly one safe shape:
+ *
+ *              bti c [; early-exit guard] ; paciasp ...     -> arm on the paciasp
+ *
+ *        A function whose byte 0 IS paciasp has no such offset: byte 0 is both the landing pad
+ *        and the signer.  That is fine for a function no indirect branch can reach (a static
+ *        function with no address taken, proven from this kernel's disassembly and used to
+ *        justify every `direct_only` argument below), and it must be REFUSED for anything a
+ *        table or a resolved pointer can reach - susfs_bti_refuse_kretprobe() names the reaching
+ *        site in the log.  Arming it "somewhere useful" is what RWC 121/123 cost two boots each.
+ *
+ * The rule this header implements:
+ *
+ *      kprobe    on any target -> arm past the landing pads/PAC prefix, strip PAC on resume
+ *      kretprobe on `bti`-prefixed entry -> arm on the paciasp (pad intact, substitution signed)
+ *      kretprobe on a paciasp-at-0 entry -> arm at byte 0 only when it is direct-call only
+ *      kretprobe on a table/pointer-reached entry -> refuse; there is no safe offset
+ *
+ * A KPROBE on a pointer-reached entry follows the kretprobe rule, not the kprobe one.  That is the
+ * class RWC 123 hit: the classifier moved the probe past the pad for `seq_read_iter`'s show callbacks
+ * but left `__arm64_sys_reboot` at +0 because the word it read at byte 0 was not the pad it
+ * expected, and a "+0" from a wrong read is indistinguishable in the log from a correct "+0" -
+ * while the cost is a panic on the next indirect call.  So an entry a table or a resolved pointer
+ * reaches is now REFUSED (-EOPNOTSUPP) unless the classifier actually SAW a landing pad at byte 0
+ * (susfs_bti_probe_point_pad_entry()).  Byte 0 is the only place that check can be made: the pad
+ * has to survive, and moving past it is the whole point.
+ *
+ * Two more statements the module can no longer omit, both because the kernel reports success
+ * without doing what was asked:
+ *
+ *      - register_kprobe() returns 0 while arming nothing when `kprobes_all_disarmed` is set (a
+ *        boot parameter or a runtime toggle) or when kp->flags has the disable bits.  Callers log
+ *        susfs_bti_kprobes_disarmed() next to their result.
+ *      - arch_arm_kprobe() returns void and DISCARDS the text-write result, so a write the
+ *        hypervisor refuses is a silent non-arm that register_kprobe() still reports as 0.
+ *        susfs_bti_verify_armed() reads the armed site back and requires the BRK kprobes should
+ *        have written there.
+ *
+ * Every "+0" answer and every refusal prints the raw words the classifier read
+ * (susfs_bti_log_words()), because a read that returned zeros, a stale `nop` or a BRK left behind
+ * all answer "+0" and cannot be told apart from the log without them.
+ *
+ * "Indirect target" is not derivable from the function itself: paciasp IS a landing pad, and most
+ * functions start with it whether or not anything calls them through a pointer.  Which functions
+ * are indirect targets was decided per call site from this kernel's disassembly (sys_call_table,
+ * seq_operations, inode/seq operation tables, and the symbols this module resolves and calls
+ * through a pointer itself), and every refusal names the table that reaches it.
+ *
+ * The resume helper strips PAC UNCONDITIONALLY.  Over-stripping is safe - xpaci is the identity on
+ * a canonical kernel address that was never signed (CONFIG_ARM64_PTR_AUTH off makes paciasp a
+ * hint) and on a signed one it is exactly the strip - while under-stripping resumes at a signed
+ * pointer and faults.  The pac flag is therefore only reported in the log, never acted on.
+ */
+#ifndef __SUSFS_BTI_H
+#define __SUSFS_BTI_H
+
+#include <linux/kprobes.h>
+#include <linux/types.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>	/* copy_from_kernel_nofault() */
+#include "susfs_log.h"		/* SUSFS_LOGI: the arm/refuse lines are evidence, not noise */
+#include "symbol_resolver.h"	/* ksu_kallsyms_lookup_name() */
+
+/* The prologue instructions this kernel uses as landing pads / PAC signers. */
+#define SUSFS_BTI_INSN_BTI	0xd503241f
+#define SUSFS_BTI_INSN_BTI_C	0xd503245f
+#define SUSFS_BTI_INSN_BTI_J	0xd503249f
+#define SUSFS_BTI_INSN_BTI_JC	0xd50324df
+#define SUSFS_BTI_INSN_PACIASP	0xd503233f
+#define SUSFS_BTI_INSN_PACIBSP	0xd503237f
+
+/* BRK #4: what arm64 kprobes writes over the probed instruction.  susfs_bti_verify_armed()
+ * requires exactly this word at kp->addr after a registration the kernel claims succeeded. */
+#define SUSFS_BTI_INSN_BRK		0xd4200080
+
+/* Stands in for a word copy_from_kernel_nofault() could not read, so a failed read is never
+ * mistaken for `brk #0`/`nop` in the evidence lines. */
+#define SUSFS_BTI_WORD_READ_FAILED	0xdeadbeefu
+
+/* bti (any form): a landing pad that no instruction-signing needs. */
+static inline bool susfs_bti_landing_pad(unsigned int insn)
+{
+	switch (insn) {
+	case SUSFS_BTI_INSN_BTI:
+	case SUSFS_BTI_INSN_BTI_C:
+	case SUSFS_BTI_INSN_BTI_J:
+	case SUSFS_BTI_INSN_BTI_JC:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* paciasp/pacibsp: a landing pad AND the instruction that signs LR. */
+static inline bool susfs_bti_pac_pad(unsigned int insn)
+{
+	return insn == SUSFS_BTI_INSN_PACIASP || insn == SUSFS_BTI_INSN_PACIBSP;
+}
+
+/* An instruction arm64 kprobes will not single-step: its effect depends on the address it runs
+ * from, so the copy kprobes executes would do the wrong thing (decode-insn.c:
+ * aarch64_insn_is_steppable()).  The match does not have to be exact: the scanner uses it only to
+ * avoid CHOOSING such an instruction as the probe point, and one it misses is still rejected by
+ * arch_prepare_kprobe() (-EINVAL), which the callers report and do not treat as armed. */
+static inline bool susfs_bti_unsteppable(unsigned int insn)
+{
+	if ((insn & 0xfc000000) == 0x14000000)	/* b */
+		return true;
+	if ((insn & 0xfc000000) == 0x94000000)	/* bl: also clobbers x30 */
+		return true;
+	if ((insn & 0xff000000) == 0x54000000)	/* b.cond */
+		return true;
+	if ((insn & 0x7e000000) == 0x34000000)	/* cbz / cbnz */
+		return true;
+	if ((insn & 0x7e000000) == 0x36000000)	/* tbz / tbnz */
+		return true;
+	if ((insn & 0xfe000000) == 0xd6000000)	/* br / blr / ret / eret */
+		return true;
+	return false;
+}
+
+/* A conditional branch: the prologue shape `bti c; cbz/tbnz <return early>; paciasp` uses one
+ * before the PAC instruction, and it is a guard whose taken path builds no frame. */
+static inline bool susfs_bti_guard(unsigned int insn)
+{
+	if ((insn & 0xff000000) == 0x54000000)	/* b.cond */
+		return true;
+	if ((insn & 0x7e000000) == 0x34000000)	/* cbz / cbnz */
+		return true;
+	if ((insn & 0x7e000000) == 0x36000000)	/* tbz / tbnz */
+		return true;
+	return false;
+}
+
+/* XPACI x0: the strip needs no key and no authentication - it is what turns the value paciasp
+ * left in LR back into the return address.  Identity on an address that was never signed. */
+static inline unsigned long susfs_bti_strip_pac(unsigned long addr)
+{
+	register unsigned long val asm("x0") = addr;
+
+	asm volatile(".inst 0xdac143e0" : "+r" (val));	/* xpaci x0 */
+	return val;
+}
+
+/* Leave the probed function as if it had been called and returned 0: at the probe point no frame
+ * exists yet, so only PC (and, for the show_* callbacks, x0) may change. */
+static inline void susfs_bti_skip_caller(struct pt_regs *regs)
+{
+	regs->pc = susfs_bti_strip_pac(regs->regs[30]);
+}
+
+/* Print the four words actually read at @at.  Attached to every "+0" classification and to every
+ * refusal, because the classifier's answer is only meaningful next to the instructions it was
+ * derived from: a read that returned zeros, a stale `nop` and a BRK already installed all answer
+ * "+0".  A word that could not be read prints as SUSFS_BTI_WORD_READ_FAILED. */
+static inline void susfs_bti_log_words(const char *sym, unsigned long at)
+{
+	unsigned int w[4];
+	int i;
+
+	for (i = 0; i < 4; i++)
+		w[i] = SUSFS_BTI_WORD_READ_FAILED;
+	for (i = 0; i < 4; i++)
