+/* The pessimistic path: the table value could not be validated, so the name decides.
+ * Resolved here rather than left to register_kprobe(), because the probe point has to
+ * skip the landing pad there too and the kernel's own .symbol_name resolution has no
+ * way to say "four bytes in".  Neither field may be set: the pair is what kprobe
+ * refuses (see susfs_kprobe.h). */
+static int hide_syms_resolve_by_name(struct kprobe *kp, const char *symbol_name,
+		bool *pac_lr)
+{
+	unsigned long addr = find_kernel_symbol_exact(symbol_name);
+	unsigned long probe;
+	int rc;
+
+	kp->addr = NULL;
+	kp->symbol_name = NULL;
+	*pac_lr = false;
+	if (!addr)
+		return -ENOENT;
+	rc = hide_syms_probe_point(addr, &probe, pac_lr);
+	if (rc)
+		return rc;
+	kp->addr = (kprobe_opcode_t *)probe;
+	return 0;
+}
