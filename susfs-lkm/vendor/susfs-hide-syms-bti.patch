+/* ---- where a kprobe may sit on a BTI-guarded table callback (RWC 121) ----
+ * /proc/kallsyms and /proc/modules are served by seq_read_iter(), which calls the
+ * seq_operations callback through a POINTER:
+ *
+ *     ldr x8, [x8, #0x18]      ; op->show
+ *     blr x8
+ *
+ * This kernel enforces BTI at EL1, and a `blr` is a BTYPE=c guarded branch: the
+ * instruction at the target must be a landing pad (`bti c`/`bti jc`) or
+ * `paciasp`/`pacibsp`.  m_show and s_show both begin with `paciasp`.  A kprobe
+ * replaces the probed instruction with BRK, so a probe at offset 0 deletes that
+ * landing pad and the next read of the file panics: RWC 121 was `grep` reading
+ * /proc/modules - "Internal error: Oops - BTI", pc = seq_read_iter+0x14c (the
+ * instruction after the blr, i.e. LR), x8 = m_show+0.  Both probes carried this;
+ * /proc/kallsyms was the other one waiting to be read.
+ *
+ * Why the LSM probes are safe where these two are not: BTI checks only INDIRECT
+ * branches.  The security hook chain calls SELinux through a CFI stub and reaches
+ * the probed body with a `b`, so the body's first instruction being BRK never
+ * matters.  m_show/s_show have no such stub - the table holds their bodies and
+ * seq_read_iter reaches them with `blr`.
+ *
+ * The probe therefore goes on the first instruction AFTER the landing-pad prefix.
+ * Only landing pads are skipped, so no frame has been set up and leaving the
+ * function early is exactly "was never called".  paciasp has already run, though,
+ * so LR holds a PAC-signed value and the skip must strip it, not jump to it.
+ */
+#define SUSFS_INSN_BTI		0xd503241f
+#define SUSFS_INSN_BTI_C	0xd503245f
+#define SUSFS_INSN_BTI_J	0xd503249f
+#define SUSFS_INSN_BTI_JC	0xd50324df
+#define SUSFS_INSN_PACIASP	0xd503233f
+#define SUSFS_INSN_PACIBSP	0xd503237f
+
+/* Set by hide_syms_probe_point(): the probe point lies after a paciasp/pacibsp, so
+ * regs->regs[30] carries a signed return address. */
+static bool hide_syms_s_show_pac_lr;
+static bool hide_syms_m_show_pac_lr;
+
+static bool hide_syms_landing_pad(unsigned int insn)
+{
+	switch (insn) {
+	case SUSFS_INSN_BTI:
+	case SUSFS_INSN_BTI_C:
+	case SUSFS_INSN_BTI_J:
+	case SUSFS_INSN_BTI_JC:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool hide_syms_pac_pad(unsigned int insn)
+{
+	return insn == SUSFS_INSN_PACIASP || insn == SUSFS_INSN_PACIBSP;
+}
+
+/* XPACI: the strip form needs no key and no authentication - it is what turns the
+ * value paciasp left in LR back into the return address.  On a pointer that was
+ * never signed (pointer authentication off, so paciasp ran as a hint) it is the
+ * identity, so the same path serves both configs. */
+static noinline unsigned long hide_syms_strip_pac(unsigned long addr)
+{
+	register unsigned long val asm("x0") = addr;
+
+	asm volatile(".inst 0xdac143e0" : "+r" (val));	/* xpaci x0 */
+	return val;
+}
+
+/* Leave the probed callback as if it had been called and returned 0.  At the probe
+ * point no frame exists yet, so only PC (and the return value) may change. */
+static void hide_syms_skip_caller(struct pt_regs *regs, bool pac_lr)
+{
+	unsigned long lr = regs->regs[30];
+
+	regs->pc = pac_lr ? hide_syms_strip_pac(lr) : lr;
+}
+
+/* The address a kprobe may sit on without destroying the landing pad.  Refuses
+ * anything it cannot read or does not recognise: an unvalidated address is not
+ * probed - this layer is non-fatal, a panic is not. */
+static int hide_syms_probe_point(unsigned long body, unsigned long *probe, bool *pac_lr)
+{
+	unsigned int insn;
+	unsigned long pc = body;
+	bool signed_lr = false;
+	int i;
+
+	for (i = 0; i < 4; i++) {
+		if (copy_from_kernel_nofault(&insn, (void *)pc, sizeof(insn)))
+			return -EFAULT;
+		if (hide_syms_landing_pad(insn)) {
+			pc += sizeof(insn);
+			continue;
+		}
+		if (hide_syms_pac_pad(insn)) {
+			signed_lr = true;
+			pc += sizeof(insn);
+			continue;
+		}
+		break;
+	}
+	if (i == 4)
+		return -EINVAL;		/* four landing pads and no body: not a function prologue */
+
+	*probe = pc;
+	*pac_lr = signed_lr;
+	return 0;
+}
